# Ace RAG middleware Docker configuration
# scripts/docker.sh will copy this file to .env.docker on first start.

TZ=Asia/Shanghai

# PostgreSQL: LangGraph AsyncPostgresSaver only
POSTGRES_IMAGE_TAG=17.10-alpine3.24
POSTGRES_DB=ace_rag
POSTGRES_USER=ace_rag
POSTGRES_PASSWORD=ace_rag_dev
POSTGRES_PORT=5432

# Redis: Retrieval Cache only; intentionally non-persistent
REDIS_IMAGE_TAG=8.4.5-alpine
REDIS_PORT=6379

# Milvus standalone dependencies
MILVUS_IMAGE_TAG=v2.6.22
MILVUS_PORT=19530
# Attu v2.6.5 is compatible with the Milvus 2.6 image above.
ATTU_IMAGE_TAG=v2.6.5
ATTU_PORT=3000
ETCD_IMAGE_TAG=v3.5.25
MINIO_IMAGE_TAG=RELEASE.2024-12-18T13-15-44Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# RabbitMQ: document ingestion task broker
RABBITMQ_IMAGE_TAG=4.1-management-alpine
RABBITMQ_DEFAULT_USER=ace_rag
RABBITMQ_DEFAULT_PASS=ace_rag_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
