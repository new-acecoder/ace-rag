# Ace RAG application configuration
# Keep this file local. Copy .env.example when creating another environment.

# Application runtime
APP_ENV=development
UVICORN_WORKERS=1

# Local middleware connections
POSTGRES_URI=postgresql://ace_rag:ace_rag_dev@127.0.0.1:5432/ace_rag
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=ace_rag_chunks
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_UPLOAD_BUCKET=ace-rag-uploads
RABBITMQ_URL=amqp://ace_rag:ace_rag_dev@127.0.0.1:5672/
RABBITMQ_INGESTION_QUEUE=ace-rag.ingestion
RABBITMQ_INGESTION_DLX=ace-rag.ingestion.dlx

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ace-rag
LANGSMITH_API_KEY=

# Chat model: DeepSeek OpenAI-compatible API
CHAT_MODEL_PROVIDER=deepseek
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_NAME=deepseek-v4-flash
CHAT_MODEL_API_KEY=

# Embedding model: SiliconFlow OpenAI-compatible API
EMBEDDING_MODEL_PROVIDER=siliconflow
EMBEDDING_MODEL_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_API_KEY=

# Knowledge ingestion
DOCUMENT_MAX_UPLOAD_BYTES=10485760
RAG_CHUNK_SIZE_CHARS=800
RAG_CHUNK_OVERLAP_CHARS=120
RAG_INDEX_VERSION_KEY=rag:retrieval:index_version
INGESTION_WORKER_CONCURRENCY=1
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_SECONDS=10
INGESTION_JOB_RETENTION_DAYS=7

# Reranker is intentionally disabled for V1
RERANKER_MODEL_PROVIDER=
RERANKER_MODEL_BASE_URL=
RERANKER_MODEL_NAME=
RERANKER_MODEL_API_KEY=
